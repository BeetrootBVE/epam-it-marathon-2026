# PRIVATE local configuration: copy as .env and never commit real credentials.
# API stage URL must end in /develop (code appends a slash automatically).
AQA_BASE_URL=https://YOUR_API_ID.execute-api.eu-north-1.amazonaws.com/develop
AQA_UI_URL=http://127.0.0.1:4200
AQA_OWNER_EMAIL=owner@example.invalid
AQA_OWNER_PASSWORD=REPLACE
AQA_OTHER_EMAIL=customer@example.invalid
AQA_OTHER_PASSWORD=REPLACE
AQA_WAITER_EMAIL=waiter@example.invalid
AQA_WAITER_PASSWORD=REPLACE
# EXISTING test table with capacity >= 4 and one AVAILABLE dish at the same location
AQA_TABLE_ID=REPLACE
AQA_DISH_ID=REPLACE
